# ---------------------------------------------------------------
# Unity .gitignore
# Patterns are unanchored so they apply to the nested project dir.
# ---------------------------------------------------------------

# Unity-generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Never ignore .meta files for assets that are tracked
!**/[Aa]ssets/**/*.meta

# Asset Store tools
# [Aa]ssets/AssetStoreTools*

# IDE / editor
.vs/
.vscode/
.idea/
.gradle/
.consulo/
ExportedObj/

# Auto-generated solution and project files
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports
sysinfo.txt
crashlytics-build.properties

# Build outputs
*.apk
*.aab
*.unitypackage
*.app

# Packed Addressables
**/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android assets
**/[Aa]ssets/[Ss]treamingAssets/aa.meta
**/[Aa]ssets/[Ss]treamingAssets/aa/*

# OS cruft
.DS_Store
Thumbs.db
